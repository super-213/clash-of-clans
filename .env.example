# Copy worker secrets into .dev.vars for local API testing. Use different random values.
INGEST_TOKEN=replace-with-a-random-32-byte-secret
ADMIN_TOKEN=replace-with-a-different-random-secret
# Python crawler publication (environment variables / GitHub Actions secrets)
ATLAS_API_URL=https://your-worker.workers.dev
ATLAS_INGEST_TOKEN=
